# Copy this file to .env and add your provider credentials.
DATABASE_URL=postgresql+asyncpg://contractguard:change-me@localhost:5432/contractguard
AUTH_SECRET_KEY=
ADMIN_EMAIL=
SESSION_COOKIE_SECURE=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
CONTRACTGUARD_MODEL=gpt-4o-mini
# Tesseract language codes; install the matching language data on the host.
CONTRACTGUARD_OCR_LANG=eng+chi_sim
# OPENROUTER_API_KEY=

# PayPal Subscriptions API. Create monthly USD plans in PayPal and add their plan IDs.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_PRO_PLAN_ID=
PAYPAL_BUSINESS_PLAN_ID=
APP_BASE_URL=http://localhost:5173
